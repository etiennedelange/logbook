{
  "name": "logbook",
  "private": true,
  "version": "0.6.5",
  "scripts": {
    "tauri": "tauri",
    "mock:web": "pnpm --dir ui dev:mock",
    "screenshots": "pnpm --dir tools/screenshots screenshots",
    "site-assets": "pnpm --dir tools/screenshots site-assets",
    "release": "node tools/release/ship.mjs",
    "test:tools": "node --test tools/release/",
    "ui-check": "pnpm --dir tools/screenshots check",
    "e2e": "node --test --test-concurrency=1 tools/e2e/"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4"
  },
  "packageManager": "pnpm@12.16.1"
}
