{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Logbook",
  "version": "0.6.0",
  "identifier": "dev.etienne.logbook",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "pnpm --dir ui dev",
    "beforeBuildCommand": "pnpm --dir ui build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Logbook", "width": 1180, "height": 760, "minWidth": 900, "minHeight": 480, "decorations": false }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Etienne de Lange",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ5RTE0QzE5NkI5RUQ4RjQKUldUMDJKNXJHVXpoU1hBTng3Z01nU3lOOHgrQklaZXEybzdRWXAzYkZrTy8yMk44MzU4YkxwMzAK",
      "endpoints": ["https://github.com/etiennedelange/logbook/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
